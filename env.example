# XenFlow Mailer - Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# APPLICATION SETTINGS
# ===========================================

# Secret key for JWT signing (CHANGE IN PRODUCTION!)
SECRET_KEY=your-super-secret-key-change-this-in-production-use-random-string

# Environment: development, staging, production
ENVIRONMENT=production

# Debug mode (set to false in production)
DEBUG=false

# ===========================================
# DATABASE
# ===========================================

POSTGRES_USER=xenflow
POSTGRES_PASSWORD=your-secure-database-password
POSTGRES_DB=xenflow

# Full database URL (auto-constructed in docker-compose)
# DATABASE_URL=postgresql://xenflow:your-password@localhost:5432/xenflow

# ===========================================
# REDIS
# ===========================================

# Redis URL (auto-constructed in docker-compose)
# REDIS_URL=redis://localhost:6379/0

# ===========================================
# EMAIL SAFETY THRESHOLDS
# ===========================================

# Maximum emails per day per sender (hard limit: 500)
MAX_EMAILS_PER_DAY=200

# Maximum emails per hour per sender (hard limit: 50)
MAX_EMAILS_PER_HOUR=20

# Maximum bounce rate before stopping (hard limit: 10%)
MAX_BOUNCE_RATE=0.05

# Maximum complaint rate before stopping (hard limit: 0.5%)
MAX_COMPLAINT_RATE=0.001

# ===========================================
# SEND WINDOW (Timezone-aware)
# ===========================================

# Send window start hour (24-hour format)
SEND_WINDOW_START_HOUR=9

# Send window end hour (24-hour format)
SEND_WINDOW_END_HOUR=17

# Send on weekdays only
SEND_WEEKDAYS_ONLY=true

# Default timezone
DEFAULT_TIMEZONE=America/New_York

# ===========================================
# WARMUP CONFIGURATION
# ===========================================

# Enable warmup for new senders
WARMUP_ENABLED=true

# Warmup limits by day
WARMUP_DAY_1_3_LIMIT=10
WARMUP_DAY_4_7_LIMIT=25
WARMUP_DAY_8_14_LIMIT=50
WARMUP_DAY_15_PLUS_LIMIT=100

# ===========================================
# GMAIL OAUTH (Optional - for Gmail senders)
# ===========================================

# Get these from Google Cloud Console
# https://console.cloud.google.com/apis/credentials
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ===========================================
# IMAP CONFIGURATION
# ===========================================

# How often to check for replies (minutes)
IMAP_CHECK_INTERVAL_MINUTES=5

# ===========================================
# LOGGING
# ===========================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log format: json or text
LOG_FORMAT=json

# ===========================================
# SENTRY (Optional - Error Tracking)
# ===========================================

# SENTRY_DSN=https://your-sentry-dsn

